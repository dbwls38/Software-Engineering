pipeline {
    agent any

    environment {
        CLASS_DIR   = 'classes'
        REPORT_DIR  = 'test-reports'
        TEST_OUTPUT = 'test-output.txt'
        JUNIT_JAR   = 'lib/junit.jar'
    }

    stages {
        stage('Checkout') {
            steps {
                // GitHub 저장소에서 소스코드 가져오기
                checkout scm
            }
        }

        stage('Prepare') {
            steps {
                // 빌드 및 테스트 결과 저장할 폴더 생성
                sh '''
                    mkdir -p ${CLASS_DIR}
                    mkdir -p ${REPORT_DIR}
                    mkdir -p lib
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "[*] Compiling source files..."
                    find src -name "*.java" > sources.txt
                    javac -encoding UTF-8 -d ${CLASS_DIR} -cp ${JUNIT_JAR} @sources.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "[*] Running tests with JUnit..."
                    java -jar ${JUNIT_JAR} \
                        --class-path ${CLASS_DIR} \
                        --reports-dir ${REPORT_DIR} \
                        --disable-banner \
                        --details-theme=ascii \
                        --config junit.platform.output.capture.stdout=true \
                        --config junit.platform.reporting.open.xml.enabled=true \
                        > ${REPORT_DIR}/${TEST_OUTPUT}
                '''
            }
        }
    }

    post {
        always {
            echo "[*] Archiving test results..."
            junit "${REPORT_DIR}/**/*.xml"
            archiveArtifacts artifacts: "${REPORT_DIR}/**/*", allowEmptyArchive: true
        }
        success {
            echo "✅ Build and test succeeded"
        }
        failure {
            echo "❌ Build and test failed"
        }
    }
}
